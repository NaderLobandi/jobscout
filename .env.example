# JobScout environment variables.
# Copy to .env and fill in real values. The real .env is gitignored —
# no credentials are ever committed (see README > Security).

# Required: powers the Scoring and Drafting agents (Claude API).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the agents. Defaults to
# claude-opus-4-8 (best quality). For near-zero-cost development, demo
# runs, and eval iterations, use Haiku instead — a full run typically
# costs a few cents:
# JOBSCOUT_MODEL=claude-haiku-4-5

# Optional Tier B job sources (JobScout works without these):
# Adzuna — free key at https://developer.adzuna.com/
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# USAJOBS — free key at https://developer.usajobs.gov/
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=your-email@example.com

# JSearch (Google for Jobs aggregator — includes postings published on
# Indeed, Glassdoor, LinkedIn, ZipRecruiter). Free key, no card:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=

# Hunter.io — optional Contact Discovery (find recruiter/HR contacts per
# posting; "🔍 Find contacts" button in the UI, --find-contacts on the
# CLI). Off by default. Unlike every other key above, this one causes
# JobScout to store a THIRD PARTY's personal data (see CLAUDE.md
# constraint 2) — display-only, JobScout never contacts anyone itself.
# Free key at https://hunter.io/api-keys
# HUNTER_API_KEY=

# Notion — optional history mirror ("📤 Sync history to Notion" button in
# the UI; --auto runs sync automatically). Mirrors job metadata, scores,
# and decisions into YOUR OWN Notion database — cover letters and your
# personal details never leave this machine. Setup:
#   1. Create an internal integration at https://www.notion.so/my-integrations
#   2. Create a database (suggested columns: a title, plus any of
#      Company, Score, Decision, Archetype, Legitimacy, Source, URL,
#      Location, Summary, Date — JobScout adapts to whatever exists)
#   3. Share the database with the integration (••• → Connections)
#   4. The database id is the 32-char hex segment in its URL
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
